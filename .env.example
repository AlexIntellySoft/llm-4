# --- Локальный сервер LM Studio (OpenAI-совместимый) ---
# Запросы не покидают машину. Запуск сервера:  lms server start
LMS_BASE_URL=http://127.0.0.1:1234/v1
LMS_API_KEY=lm-studio

# --- Модель генерации ---
# Доступные короткие имена: gemma-4-e4b, qwen3.5-9b, qwen3-4b-nothink
# По умолчанию стоит модель без «рассуждения»: на 16 ГБ RAM она в 10 раз
# быстрее при том же качестве ответа (см. отчёт, раздел про модели).
DEFAULT_LLM=qwen3-4b-nothink
TEMPERATURE=0.1
MAX_TOKENS=3000

# --- Эмбеддинги ---
# e5-base   — intfloat/multilingual-e5-base через sentence-transformers (рекомендуется)
# nomic-lms — nomic-embed-text-v1.5 через LM Studio (для сравнения)
DEFAULT_EMBEDDER=e5-base

# --- Поиск и нарезка ---
TOP_K=4
CHUNK_SIZE=700
CHUNK_OVERLAP=120
CONTEXTUAL_HEADER=true

# Порог косинусного расстояния для отсечения нерелевантных чанков.
# По умолчанию выключен: в отчёте показано, что порог не отделяет
# вопросы вне базы от вопросов по базе.
# MAX_DISTANCE=0.22

# Полностью офлайн-режим (после первой загрузки модели эмбеддингов):
# HF_HUB_OFFLINE=1
